# ============================================================================
# TRADE24/7 — Environment Variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Local Docker default matches docker-compose.yml
DATABASE_URL="postgresql://trade247:trade247@localhost:5432/trade247?schema=public"

# ----------------------------------------------------------------------------
# NextAuth
# ----------------------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave blank to disable a provider)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# AI Services (used by the AI Investment Analyst & Opportunity Scoring)
# ----------------------------------------------------------------------------
# Anthropic Claude — recommended default model: claude-opus-4-8
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# ----------------------------------------------------------------------------
# Market Data Providers (all optional; the app degrades gracefully with mocks)
# ----------------------------------------------------------------------------
# Stocks / ETFs / Forex / Commodities
ALPHAVANTAGE_API_KEY=""
FINNHUB_API_KEY=""
POLYGON_API_KEY=""
# Crypto
COINGECKO_API_KEY=""
# Economic calendar / macro
TRADING_ECONOMICS_API_KEY=""

# ----------------------------------------------------------------------------
# News Intelligence
# ----------------------------------------------------------------------------
NEWSAPI_KEY=""
MARKETAUX_API_KEY=""

# ----------------------------------------------------------------------------
# WhatsApp Business Platform (official Cloud API)
# See docs/SETUP.md → "WhatsApp Business API" for how to obtain these.
# ----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# The E.164 number that should receive alerts, e.g. +447700900123
WHATSAPP_DEFAULT_RECIPIENT=""
# Name of an approved message template (recommended for outbound alerts)
WHATSAPP_TEMPLATE_NAME="trade247_alert"

# ----------------------------------------------------------------------------
# Broker Integrations (OAuth / API keys — never hardcode elsewhere)
# ----------------------------------------------------------------------------
COINBASE_CLIENT_ID=""
COINBASE_CLIENT_SECRET=""
# OAuth redirect (must match the one registered in the Coinbase OAuth app).
# Defaults to <NEXTAUTH_URL>/api/brokers/coinbase/callback when unset.
COINBASE_REDIRECT_URI=""
# Robinhood has no official public API; integration is a future adapter.

# Encrypts broker OAuth tokens at rest (AES-256-GCM). REQUIRED once a broker is
# connected. Generate: `openssl rand -base64 32`
ENCRYPTION_KEY=""

# ----------------------------------------------------------------------------
# Scheduled scanning (opportunity monitor + alerts)
# ----------------------------------------------------------------------------
# Bearer token that authorises POST/GET /api/scan for cron jobs.
# Generate: `openssl rand -hex 32`
CRON_SECRET=""

# ----------------------------------------------------------------------------
# Feature flags / runtime
# ----------------------------------------------------------------------------
NODE_ENV="development"
# Set to "true" to allow the app to boot with mock data when providers are unset
ENABLE_MOCK_DATA="true"
