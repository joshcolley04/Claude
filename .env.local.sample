# ============================================================================
# TRADE24/7 — LOCAL (Docker) quick-start env
# Usage:
#   cp .env.local.sample .env
#   # paste the four secrets below (values were generated for you in chat, or
#   # run:  openssl rand -base64 32   /   openssl rand -hex 32 )
#   docker compose up --build
#   # open http://localhost:3000   (demo login: demo@trade247.local / Demo1234!)
#
# These are LOCAL DEVELOPMENT defaults. Generate fresh secrets for production.
# ============================================================================

# DATABASE_URL is provided by docker-compose (the app talks to the db container).
# For running `npm run dev` outside Docker, uncomment this instead:
# DATABASE_URL="postgresql://trade247:trade247@localhost:5432/trade247?schema=public"

# --- Required to boot -------------------------------------------------------
NEXTAUTH_SECRET=""     # paste generated value (openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"

# --- Required only once you connect a broker (Coinbase) ---------------------
ENCRYPTION_KEY=""      # paste generated value (openssl rand -base64 32)

# --- Optional: everything below is OFF by default; the app runs on mock data -
# AI analyst (leave blank for illustrative responses)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Live market data (leave blank to use realistic mock data)
FINNHUB_API_KEY=""
# CoinGecko works with no key (rate-limited)

# WhatsApp alerts (leave blank to simulate)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_DEFAULT_RECIPIENT=""

# Coinbase OAuth (leave blank until you create an OAuth app)
COINBASE_CLIENT_ID=""
COINBASE_CLIENT_SECRET=""

# Scheduled scan + TradingView webhook secrets (paste generated hex values)
CRON_SECRET=""
TRADINGVIEW_WEBHOOK_SECRET=""

ENABLE_MOCK_DATA="true"
